# All paths may be absolute; default is <repository>/data.
DATA_DIR=./data
# Built-in defaults. Override only for another compatible adapter.
# TIREK_INGESTOR=backend.app.ml_adapter:normalize_dataset
# TIREK_PIPELINE=backend.app.ml_adapter:TirekCalculationPipeline
# Optional LLM, read on server startup from backend/.env (not committed).
# OpenAI-compatible Chat Completions. Choose a model available to your account.
# TIREK_LLM_BASE_URL=https://api.openai.com/v1
# TIREK_LLM_MODEL=
# TIREK_LLM_API_KEY=
# Local compatible endpoints may use http://127.0.0.1:<port>/v1 without a key.
